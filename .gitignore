# OS
.DS_Store
Thumbs.db

# Editors
*.swp
*.swo
*~
.idea/
.vscode/

# Env / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
dist/
.build/

# Playwright MCP local dumps (console/page snapshots)
.playwright-mcp/

# Generated/private outputs (student data and future teaching artifacts)
outputs/

# User-provided durable inputs (drop-zone under data/students/.../raw/)
data/

# Local agent planning/spec scratch (superpowers)
docs/superpowers/

# Local research references (paper PDFs, book excerpts, source list): large and
# copyright-sensitive; nothing in the packages links here, so keep it local.
docs/refs/

# Local debug output under .scratch/. Issue and spec docs there stay tracked;
# only browser profiles, npm installs, packed tarballs and ad-hoc probes are
# local.
.scratch/*-profile/
.scratch/packtest/
.scratch/dsh-skill-provider/node_modules

# Ad-hoc probes, test logs and browser repro harnesses used while debugging.
# specs, issue files and decision records under .scratch/ stay tracked.
.scratch/*.log
.scratch/*.html
.scratch/repro-*.mjs
.scratch/check-board-jitter.mjs
.scratch/repro-*.log
.scratch/**/*.pre-acceptance.bak
.scratch/debug-geometry-draw/
.scratch/dsh-skill-provider/backup/
.scratch/dsh-skill-provider/patched/
.scratch/dsh-skill-provider/test-results*.txt
.scratch/dsh-skill-provider/verify-provider-load.mjs
