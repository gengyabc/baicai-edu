# OS
.DS_Store
Thumbs.db

# Editors
*.swp
*.swo
*~
.idea/
.vscode/

# Env / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
dist/
.build/

# Playwright MCP local dumps (console/page snapshots)
.playwright-mcp/

# Generated/private outputs (student data and future teaching artifacts)
outputs/

# User-provided durable inputs (drop-zone under data/students/.../raw/)
data/

# Local agent planning/spec scratch (superpowers)
docs/superpowers/
.superpowers/

# Local research references (paper PDFs, book excerpts, source list): large and
# copyright-sensitive; nothing in the packages links here, so keep it local.
docs/refs/

# Local debug output under .scratch/. Only the issue tracker's durable documents
# stay tracked — see docs/agents/issue-tracker.md: each effort keeps its spec.md,
# map.md and issues/NN-*.md. Everything else there (run logs, fixtures, captured
# artifacts, agent brief/report/review transcripts, browser profiles, npm
# installs, packed tarballs, worktrees) is per-run debris and stays local.
.scratch/*
!.scratch/*/
.scratch/*/*
!.scratch/*/spec.md
!.scratch/*/map.md
!.scratch/*/issues/
.scratch/*/issues/*
!.scratch/*/issues/*.md

