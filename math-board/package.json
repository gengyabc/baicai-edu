{
  "name": "dsh-edu-math-board",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "表达型数学工作台：猫、汽车等可切换图案、可命名分组与同形合并；学生自己设定量级颜色，并以结构化 JSON 提交想法。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "config-bridge.js",
    "model.js",
    "view.js",
    "board.css",
    "build.mjs",
    "preview.mjs",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test model.test.js config-bridge.test.js view.test.js",
    "preview": "node preview.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
