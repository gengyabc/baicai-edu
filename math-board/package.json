{
  "name": "dsh-edu-math-board",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "表达型数学工作台：数量画板（预设颜色创建图案、可命名分组与同形合并）与几何画板（点、线段、多边形、圆、平行四边形、矩形）并列两个 tab；以只读快照和学生自述提交。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "config-bridge.js",
    "clear-bridge.js",
    "model.js",
    "trace.js",
    "view.js",
    "view-component.js",
    "question-reference.js",
    "file-picker.js",
    "geometry/model.js",
    "geometry-view.js",
    "board-shell.js",
    "board.css",
    "build.mjs",
    "preview.mjs",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test *.test.js geometry/model.test.js",
    "preview": "node preview.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
