{
  "name": "baicai-edu-math",
  "version": "0.1.3",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "description": "Shared math contracts for the primary math bands: student-authored problems, practice evidence, the math-board protocol, and handwriting/image reading. Rules only; never a teaching implementation or resolver candidate.",
  "author": {
    "name": "gengyabc",
    "url": "https://github.com/gengyabc"
  },
  "keywords": [
    "education",
    "math",
    "k12",
    "teaching-contracts",
    "skills",
    "dsh",
    "dsh-plugin"
  ],
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gengyabc/baicai-edu.git",
    "directory": "math-common"
  },
  "homepage": "https://github.com/gengyabc/baicai-edu/tree/main/math-common#readme",
  "bugs": {
    "url": "https://github.com/gengyabc/baicai-edu/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dependencies": {
    "baicai-edu-learn": "^0.1.3"
  },
  "files": [
    "cordis.patch.yml",
    "build.json",
    "docs",
    "resources",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "cd .. && node scripts/check-skills.mjs && node --test scripts/*.test.mjs"
  }
}
