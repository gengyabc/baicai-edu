{
  "name": "baicai-edu-math-primary-low",
  "version": "0.1.3",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "description": "CGI-style primary math teaching skills for baicai-edu, focused on grades 1-3 (grade tunes language and representation, not what students may explore): adaptive turns, strategy diagnosis, targeted practice, and student-authored problem sessions.",
  "author": {
    "name": "gengyabc",
    "url": "https://github.com/gengyabc"
  },
  "keywords": [
    "education",
    "math",
    "primary-school",
    "grades-1-3",
    "cgi",
    "dsh",
    "dsh-plugin"
  ],
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gengyabc/baicai-edu.git",
    "directory": "math-primary-low"
  },
  "homepage": "https://github.com/gengyabc/baicai-edu/tree/main/math-primary-low#readme",
  "bugs": {
    "url": "https://github.com/gengyabc/baicai-edu/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dependencies": {
    "baicai-edu-learn": "^0.1.3",
    "baicai-edu-math": "^0.1.3",
    "baicai-edu-math-board": "^0.6.1"
  },
  "files": [
    "cordis.patch.yml",
    "build.json",
    "docs",
    "resources",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "cd .. && node scripts/check-skills.mjs && node --test scripts/*.test.mjs"
  }
}
