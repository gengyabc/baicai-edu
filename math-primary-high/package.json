{
  "name": "baicai-edu-math-primary-high",
  "version": "0.1.4",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "description": "Task-driven upper-primary (grades 4-6) math teaching with multiple methods, evidence-based support, strategy diagnosis, practice, student-authored problems, and real-world modeling; the math board is optional.",
  "author": {
    "name": "gengyabc",
    "url": "https://github.com/gengyabc"
  },
  "keywords": [
    "education",
    "math",
    "primary-school",
    "grades-4-6",
    "problem-solving",
    "dsh",
    "dsh-plugin"
  ],
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gengyabc/baicai-edu.git",
    "directory": "math-primary-high"
  },
  "homepage": "https://github.com/gengyabc/baicai-edu/tree/main/math-primary-high#readme",
  "bugs": {
    "url": "https://github.com/gengyabc/baicai-edu/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dependencies": {
    "baicai-edu-learn": "^0.1.4",
    "baicai-edu-math": "^0.1.4"
  },
  "files": [
    "cordis.patch.yml",
    "build.json",
    "docs",
    "resources",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "cd .. && node scripts/check-skills.mjs && node --test scripts/*.test.mjs"
  }
}
